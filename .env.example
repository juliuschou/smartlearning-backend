# Application
PORT=3000
NODE_ENV=development
# CORS: comma-separated exact origins. Production must list exact origins.
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000

# Database
# 開發環境請參考 docker-postgresql-setup.md 以 Docker 啟動 PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartlearning_dev
DB_USERNAME=smartlearning
DB_PASSWORD=changeme
DATABASE_URL="postgresql://smartlearning:changeme@localhost:5432/smartlearning_dev?schema=public"

# Secrets — generate with: openssl rand -base64 32
COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Web Session lifetime (M2 關鍵技術決策 §4)
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
# SESSION_COOKIE_SECURE=true

# Login rate limit. Development/test use the safe in-memory default. Production
# must use redis-required with an independent secret and URL.
LOGIN_RATE_LIMIT_MODE=memory
LOGIN_RATE_LIMIT_ACCOUNT_MAX=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_SOURCE_MAX=20
LOGIN_RATE_LIMIT_SOURCE_WINDOW_MS=300000
LOGIN_RATE_LIMIT_CONNECT_TIMEOUT_MS=2000
LOGIN_RATE_LIMIT_COMMAND_TIMEOUT_MS=500
# LOGIN_RATE_LIMIT_REDIS_URL="redis://localhost:6379"
# LOGIN_RATE_LIMIT_KEY_SECRET=replace-with-a-separate-32-character-secret

# CLI operation rate limits (per CliCredential.id, in-memory single instance)
CLI_COURSES_LIST_RATE_LIMIT_MAX=60
CLI_COURSES_LIST_RATE_LIMIT_WINDOW_MS=60000
CLI_COURSES_CREATE_RATE_LIMIT_MAX=10
CLI_COURSES_CREATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_VALIDATE_RATE_LIMIT_MAX=30
CLI_BATCH_VALIDATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_CONFIRM_RATE_LIMIT_MAX=20
CLI_BATCH_CONFIRM_RATE_LIMIT_WINDOW_MS=60000

# Bootstrap first admin — read by `npm run bootstrap:admin` CLI, NOT required
# for normal app start. Secret is passed via env (never command line / shell history).
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Realtime Redis adapter remains independent from the login limiter.
REALTIME_REDIS_MODE=off
# REDIS_URL="redis://localhost:6379"

# Deletion manifest provider. Local is the safe default; S3 requires all fields below.
DELETION_MANIFEST_PROVIDER=local
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=smartlearning-manifests
# S3_PREFIX=deletion-manifests
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_OBJECT_LOCK_DAYS=90
