# Application
PORT=3000
NODE_ENV=development
# CORS: comma-separated origins, or "*" (dev only). Production must list exact origins.
CORS_ORIGIN=http://localhost:3000

# Database
# 開發環境請參考 docker-postgresql-setup.md 以 Docker 啟動 PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartlearning_dev
DB_USERNAME=smartlearning
DB_PASSWORD=changeme

# Prisma 連線字串（格式：postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public）
DATABASE_URL="postgresql://smartlearning:changeme@localhost:5432/smartlearning_dev?schema=public"

# Secrets — generate with: openssl rand -base64 32
# Cookie signing / __Host- session cookie (Phase 2 auth)
COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Web Session lifetime (M2 關鍵技術決策 §4)
# Idle timeout (ms) — default 30m
SESSION_IDLE_MS=1800000
# Absolute lifetime (ms) — default 8h
SESSION_ABSOLUTE_MS=28800000

# Active LiveSession automatic close (default 8h) and sweep interval (default 60s)
LIVE_SESSION_AUTO_CLOSE_MS=28800000
LIVE_SESSION_AUTO_CLOSE_TICK_MS=60000
# __Host- cookies require Secure. Set false ONLY for plain-HTTP test env;
# production must keep this true (or unset → defaults to true).
# SESSION_COOKIE_SECURE=true

# Bootstrap first admin — read by `npm run bootstrap:admin` CLI, NOT required
# for normal app start. Secret is passed via env (never command line / shell
# history); interactive-stdin/Docker secret is the production target (deferred).
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Redis (optional until Phase 7/9; presence enables readiness check + Socket adapter)
# REDIS_URL="redis://localhost:6379"