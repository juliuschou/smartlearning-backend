// Prisma schema — SmartLearning backend
// 連線 URL 已移至 prisma.config.ts（Prisma 7 新制），schema 僅保留 provider。
// 管理指令：
//   npx prisma generate       產生 client（schema 變更後執行）
//   npx prisma migrate dev    開發環境建立/套用 migration
//   npx prisma studio         開啟資料庫 GUI
//
// 設計前提（M2 關鍵技術決策）：
//   - Identity：UUID v7（app 層產生，寫入帶值）。PK 型別為 String(@db.Uuid)。
//   - 狀態：TEXT + CHECK（CHECK 由手寫 raw SQL migration 補，Prisma 不直接支援）。
//   - 其餘 domain model 留待 Phase 2+ 依完整 ERD 建立。

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 系統設定 / bootstrap 狀態旗標。Phase 1 baseline，供 health/migration 流程驗證。
model SystemSetting {
  /// UUID v7（app 層產生）
  id        String   @id @db.Uuid
  /// 設定鍵，全域唯一（如 "bootstrap_completed"）
  key       String   @unique
  /// 設定值（JSONB）
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("system_setting")
}

/// Web 帳號。角色：admin | teacher | student（CHECK 由手寫 migration 補）。
/// 身分：UUID v7（app 層產生）。狀態：TEXT + CHECK（role/status）。
/// student 的 can_create_course 必須為 false，由 application 與 migration 共同守護。
/// 切片範圍：bootstrap→首位 admin、admin 建帳號、login、session、disable/restore。
model Account {
  /// UUID v7（app 層產生）
  id                 String    @id @db.Uuid
  /// 登入識別碼，全域唯一
  username           String    @unique
  /// 顯示名稱
  displayName        String    @map("display_name")
  /// 角色：admin | teacher | student（CHECK 由 migration 補）
  role               String
  /// 狀態：active | disabled（CHECK 由 migration 補，default active）
  status             String    @default("active")
  /// 帳號級「可建立 Course」授權旗標（US-F16），由 admin 切換
  canCreateCourse    Boolean   @default(false) @map("can_create_course")
  /// Argon2id 雜湊；bootstrap/admin 建立時寫入，永不存明文
  passwordHash       String?   @map("password_hash")
  /// 首次登入是否強制改密碼；切片一律 false（force-change 延後）
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// 密碼變更時間，作為 credential 失效參考點（切片未用於撤銷）
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  /// 停用時間（disable/restore 延後，欄位先建以保持 additive）
  disabledAt         DateTime? @map("disabled_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// 建立者；bootstrap 首位 admin 為 null，self-FK ON DELETE RESTRICT
  createdBy          String?   @map("created_by") @db.Uuid

  sessions          WebSession[]
  courses           Course[]                  @relation("CourseOwner")
  cliCredentials    CliCredential[]
  validationTokens  QuestionValidationToken[]
  createdByAccount  Account?                  @relation("AccountCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAccounts   Account[]                 @relation("AccountCreatedBy")
  courseEnrollments CourseEnrollment[]        @relation("StudentCourseEnrollments")
  participants      Participant[]

  @@index([createdBy], map: "idx_account_created_by")
  @@map("account")
}

/// Web Session — PostgreSQL 為唯一權威。Cookie 只放高熵 opaque token，DB 存 SHA-256 hash。
/// 期限：idle 30m（lastSeenAt）、absolute 8h（expiresAt）。撤銷/rotation/全 session 撤銷延後。
model WebSession {
  /// UUID v7（app 層產生）
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  /// cookie 原值的 SHA-256 hash，唯一
  cookieHash String    @unique @map("cookie_hash")
  /// 建立時來源 IP（切片不強制）
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 上次活動時間，idle 30m 過期依此
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  /// 絕對過期時間 = 建立時 now + 8h
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  /// 撤銷時間（logout/password-change/disable）
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  /// 最近一次完成 password step-up 的時間；有效期由 application layer 固定為 10 分鐘
  stepUpAt   DateTime? @map("step_up_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_web_session_account")
  @@map("web_session")
}

/// 課程。owner 不可變、draft→archived terminal、archived 不可寫。
/// 題目/live_session 依後續 phase 加入。切片只做 create/list/detail/archive。
model Course {
  /// UUID v7（app 層產生）
  id             String   @id @db.Uuid
  ownerAccountId String   @map("owner_account_id") @db.Uuid
  name           String
  description    String?
  /// 狀態：draft | archived（CHECK 由 migration 補，default draft）
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner           Account              @relation("CourseOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  questions       QuestionDefinition[]
  liveSessions    LiveSession[]
  enrollments     CourseEnrollment[]
  archivedResults ArchivedResult[]

  @@index([ownerAccountId], map: "idx_course_owner")
  @@map("course")
}

/// Persistent roster membership between a Course and a student Account.
/// Removed rows are retained and reactivated on a later add; history queries are
/// intentionally out of scope for this phase.
model CourseEnrollment {
  id               String   @id @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  studentAccountId String   @map("student_account_id") @db.Uuid
  /// Status: active | removed (CHECK由 migration 補)
  status           String   @default("active")
  enrolledAt       DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course         Course  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  studentAccount Account @relation("StudentCourseEnrollments", fields: [studentAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([courseId, studentAccountId], map: "uq_course_enrollment_course_student")
  @@index([courseId, status], map: "idx_course_enrollment_course_status")
  @@index([studentAccountId, status], map: "idx_course_enrollment_student_status")
  @@map("course_enrollment")
}

/// Reusable, course-owned question definition. Supports poll (single/multiple),
/// open_text, and quiz; all three types are activatable into a LiveSession.
model QuestionDefinition {
  id            String   @id @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  type          String
  prompt        String
  selectionMode String?  @map("selection_mode")
  position      Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course            Course                         @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  options           QuestionOption[]
  sessionQuestions  SessionQuestion[]
  sessionSelections LiveSessionQuestionSelection[]

  @@unique([courseId, position], map: "uq_question_definition_course_position")
  @@unique([id, courseId], map: "uq_question_definition_id_course")
  @@index([courseId], map: "idx_question_definition_course")
  @@map("question_definition")
}

model QuestionOption {
  id                   String  @id @db.Uuid
  questionDefinitionId String  @map("question_definition_id") @db.Uuid
  optionRef            String? @map("option_ref")
  text                 String
  isCorrect            Boolean @default(false) @map("is_correct")
  position             Int

  questionDefinition QuestionDefinition @relation(fields: [questionDefinitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([questionDefinitionId, optionRef], map: "uq_question_option_question_ref")
  @@unique([questionDefinitionId, position], map: "uq_question_option_question_position")
  @@index([questionDefinitionId, position], map: "idx_question_option_question_position")
  @@map("question_option")
}

/// One classroom run for a Course.
model LiveSession {
  id               String    @id @db.Uuid
  courseId         String    @map("course_id") @db.Uuid
  status           String    @default("waiting")
  sessionCode      String    @unique @map("session_code")
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  closedAt         DateTime? @map("closed_at") @db.Timestamptz
  autoClosed       Boolean   @default(false) @map("auto_closed")
  realtimeEventSeq BigInt    @default(0) @map("realtime_event_seq")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  course             Course                         @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  questionSelections LiveSessionQuestionSelection[]
  questions          SessionQuestion[]
  participants       Participant[]
  submissions        Submission[]
  realtimeEvents     LiveSessionEvent[]
  archivedResult     ArchivedResult?

  @@unique([id, courseId], map: "uq_live_session_id_course")
  @@index([courseId], map: "idx_live_session_course")
  @@map("live_session")
}

/// Ordered source-question selection retained while a LiveSession is waiting.
/// The denormalized courseId is constrained against both parents so a direct
/// database writer cannot join a session to a question from another course.
model LiveSessionQuestionSelection {
  id                   String @id @db.Uuid
  liveSessionId        String @map("live_session_id") @db.Uuid
  questionDefinitionId String @map("question_definition_id") @db.Uuid
  courseId             String @map("course_id") @db.Uuid
  position             Int

  liveSession        LiveSession        @relation(fields: [liveSessionId, courseId], references: [id, courseId], onDelete: Cascade, onUpdate: NoAction)
  questionDefinition QuestionDefinition @relation(fields: [questionDefinitionId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([liveSessionId, position], map: "uq_live_session_selection_session_position")
  @@unique([liveSessionId, questionDefinitionId], map: "uq_live_session_selection_question")
  @@index([liveSessionId, position], map: "idx_live_session_selection_session_position")
  @@map("live_session_question_selection")
}

/// Immutable question snapshot belonging to a LiveSession.
model SessionQuestion {
  id                    String    @id @db.Uuid
  liveSessionId         String    @map("live_session_id") @db.Uuid
  questionDefinitionId  String?   @map("question_definition_id") @db.Uuid
  position              Int
  status                String    @default("not_open")
  aggregateVersion      Int       @default(0) @map("aggregate_version")
  snapshotType          String    @map("snapshot_type")
  snapshotPrompt        String    @map("snapshot_prompt")
  snapshotSelectionMode String?   @map("snapshot_selection_mode")
  openedAt              DateTime? @map("opened_at") @db.Timestamptz
  closedAt              DateTime? @map("closed_at") @db.Timestamptz

  liveSession        LiveSession             @relation(fields: [liveSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  questionDefinition QuestionDefinition?     @relation(fields: [questionDefinitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  options            SessionQuestionOption[]
  submissions        Submission[]
  realtimeEvents     LiveSessionEvent[]

  @@unique([id, liveSessionId], map: "uq_session_question_id_live_session")
  @@unique([liveSessionId, position], map: "uq_session_question_session_position")
  @@index([liveSessionId, position], map: "idx_session_question_session_position")
  @@map("session_question")
}

model SessionQuestionOption {
  id                String  @id @db.Uuid
  sessionQuestionId String  @map("session_question_id") @db.Uuid
  optionRef         String? @map("option_ref")
  text              String
  isCorrect         Boolean @default(false) @map("is_correct")
  position          Int

  sessionQuestion SessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionQuestionId, optionRef], map: "uq_session_question_option_question_ref")
  @@unique([sessionQuestionId, position], map: "uq_session_question_option_question_position")
  @@index([sessionQuestionId, position], map: "idx_session_question_option_question_position")
  @@map("session_question_option")
}

/// Anonymous or account-bound participant identity scoped to one LiveSession.
/// Account-bound rows retain an internal token hash for schema compatibility;
/// that token is never returned or accepted as the cookie identity.
model Participant {
  id            String   @id @db.Uuid
  liveSessionId String   @map("live_session_id") @db.Uuid
  accountId     String?  @map("account_id") @db.Uuid
  displayName   String   @map("display_name")
  tokenHash     String   @map("token_hash")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz

  liveSession LiveSession  @relation(fields: [liveSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  submissions Submission[]

  @@unique([id, liveSessionId], map: "uq_participant_id_live_session")
  @@unique([liveSessionId, accountId], map: "uq_participant_session_account")
  @@unique([liveSessionId, tokenHash], map: "uq_participant_session_token_hash")
  @@index([liveSessionId, tokenHash], map: "idx_participant_session_token_hash")
  @@index([accountId], map: "idx_participant_account")
  @@map("participant")
}

/// First accepted answer; no update path. `selectedOptionRefs` (option answers)
/// and `textAnswer` (open_text answers) are mutually exclusive; the non-null
/// one is set by the application layer based on `SessionQuestion.snapshotType`.
model Submission {
  id                 String   @id @db.Uuid
  liveSessionId      String   @map("live_session_id") @db.Uuid
  sessionQuestionId  String   @map("session_question_id") @db.Uuid
  participantId      String   @map("participant_id") @db.Uuid
  idempotencyKey     String   @unique @map("idempotency_key") @db.Uuid
  selectedOptionRefs Json?    @map("selected_option_refs")
  textAnswer         String?  @map("text_answer")
  submittedAt        DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  liveSession     LiveSession     @relation(fields: [liveSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessionQuestion SessionQuestion @relation(fields: [sessionQuestionId, liveSessionId], references: [id, liveSessionId], onDelete: Restrict, onUpdate: NoAction)
  participant     Participant     @relation(fields: [participantId, liveSessionId], references: [id, liveSessionId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([participantId, sessionQuestionId], map: "uq_submission_participant_question")
  @@index([sessionQuestionId], map: "idx_submission_session_question")
  @@index([liveSessionId], map: "idx_submission_live_session")
  @@map("submission")
}

/// Durable realtime outbox/event log. Projection inputs are a small allowlisted
/// JSON object; actor-specific data is materialized from PostgreSQL at delivery.
/// `targetParticipantId` is routing-only metadata for open-question submitter
/// notifications; it is never copied into projectionInput or an event payload.
model LiveSessionEvent {
  id                  String    @id @db.Uuid
  liveSessionId       String    @map("live_session_id") @db.Uuid
  sessionQuestionId   String?   @map("session_question_id") @db.Uuid
  targetParticipantId String?   @map("target_participant_id") @db.Uuid
  eventName           String    @map("event_name")
  schemaVersion       Int       @default(1) @map("schema_version")
  eventSeq            BigInt    @map("event_seq")
  aggregateVersion    Int       @default(0) @map("aggregate_version")
  serverTimestamp     DateTime  @default(now()) @map("server_timestamp") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  visibility          String
  projectionInput     Json?     @map("projection_input")
  deliveryState       String    @default("pending") @map("delivery_state")
  attemptCount        Int       @default(0) @map("attempt_count")
  nextAttemptAt       DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  claimedAt           DateTime? @map("claimed_at") @db.Timestamptz
  claimToken          String?   @map("claim_token") @db.Uuid
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz
  lastFailureClass    String?   @map("last_failure_class")
  coalesced           Boolean   @default(false)
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz

  liveSession     LiveSession      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessionQuestion SessionQuestion? @relation(fields: [sessionQuestionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([liveSessionId, eventSeq], map: "uq_live_session_event_session_seq")
  @@index([liveSessionId, eventSeq], map: "idx_live_session_event_replay")
  @@index([deliveryState, nextAttemptAt, leaseExpiresAt], map: "idx_live_session_event_delivery")
  @@index([expiresAt], map: "idx_live_session_event_expiry")
  @@index([liveSessionId, sessionQuestionId, visibility, deliveryState, aggregateVersion], map: "idx_live_session_event_coalesce")
  @@index([liveSessionId, targetParticipantId, eventSeq], map: "idx_live_session_event_target")
  @@map("live_session_event")
}

/// Immutable anonymous archive for one closed session.
model ArchivedResult {
  id             String          @id @db.Uuid
  liveSessionId  String          @unique @map("live_session_id") @db.Uuid
  courseId       String          @map("course_id") @db.Uuid
  sessionLabel   String          @map("session_label")
  startedAt      DateTime        @map("started_at") @db.Timestamptz
  closedAt       DateTime        @map("closed_at") @db.Timestamptz
  purgeAt        DateTime        @map("purge_at") @db.Timestamptz
  status         String          @default("active")
  payload        Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  liveSession    LiveSession     @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  deletionEvents DeletionEvent[]
  manifestOutbox DeletionManifestOutbox?

  @@index([courseId, closedAt], map: "idx_archived_result_course_closed")
  @@index([purgeAt, status], map: "idx_archived_result_purge_status")
  @@map("archived_result")
}

/// Minimal governance tombstone/request. Never stores answer-bearing content.
model DeletionEvent {
  id                String          @id @db.Uuid
  archivedResultId  String?         @map("archived_result_id") @db.Uuid
  liveSessionId     String          @map("live_session_id") @db.Uuid
  courseId          String          @map("course_id") @db.Uuid
  requesterId       String?         @map("requester_id") @db.Uuid
  executorId        String?         @map("executor_id") @db.Uuid
  trigger           String
  reason            String?
  status            String
  deletedCategories Json?           @map("deleted_categories")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz
  errorCode         String?         @map("error_code")
  resolvedByEventId String?         @unique(map: "uq_deletion_event_resolved_by") @map("resolved_by_event_id") @db.Uuid
  archivedResult    ArchivedResult? @relation(fields: [archivedResultId], references: [id], onDelete: SetNull)
  resolvedByEvent   DeletionEvent?  @relation("DeletionEventResolution", fields: [resolvedByEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolvedRequests  DeletionEvent[] @relation("DeletionEventResolution")
  manifestOutbox    DeletionManifestOutbox?

  @@index([liveSessionId, trigger], map: "idx_deletion_event_session_trigger")
  @@index([status, createdAt, id], map: "idx_deletion_event_pending_queue")
  @@map("deletion_event")
}

/// Transactional, provider-neutral deletion manifest outbox.
model DeletionManifestOutbox {
  id              String        @id @db.Uuid
  archivedResultId String       @unique @map("archived_result_id") @db.Uuid
  deletionEventId String        @unique @map("deletion_event_id") @db.Uuid
  contractVersion String        @map("contract_version")
  manifest        Json
  status          String        @default("pending")
  attempts        Int           @default(0)
  nextAttemptAt   DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError       String?       @map("last_error")
  leaseToken      String?       @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?     @map("lease_expires_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  exportedAt      DateTime?     @map("exported_at") @db.Timestamptz
  archivedResult  ArchivedResult @relation(fields: [archivedResultId], references: [id], onDelete: Restrict)
  deletionEvent   DeletionEvent @relation(fields: [deletionEventId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, id], map: "idx_deletion_manifest_outbox_pending")
  @@map("deletion_manifest_outbox")
}

/// CLI 憑證 — 與 Web Session 分離的獨立認證路徑。raw key 只在簽發時回傳一次，
/// DB 只存 SHA-256 hash + 非機密 metadata。MVP scope=all_courses；停用帳號立即撤銷所有 key。
/// M2 紅卡 #8：can_create_course=false 不撤銷 CLI key；CLI 撤銷是獨立 admin 流程。
model CliCredential {
  /// UUID v7（app 層產生）
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  /// 每帳號內唯一的名稱
  name       String
  /// raw key 的 SHA-256 hash，全域唯一
  keyHash    String    @unique @map("key_hash")
  /// 授權範圍：all_courses | single_course（CHECK 由 migration 補；MVP 只用 all_courses）
  scope      String    @default("all_courses")
  /// 狀態：active | revoked（CHECK 由 migration 補）
  status     String    @default("active")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid

  account          Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  validationTokens QuestionValidationToken[]
  rotatedFrom     CliCredential?            @relation("CliCredentialRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rotatedTo       CliCredential?            @relation("CliCredentialRotation")

  @@unique([accountId, name], map: "uq_cli_credential_account_name")
  @@unique([rotatedFromId], map: "uq_cli_credential_rotated_from")
  @@index([accountId], map: "idx_cli_credential_account")
  @@map("cli_credential")
}

/// 批次驗證 token — DB-backed opaque（非 signed），存 hash only。
/// 綁 actor/account + optional CLI key + course + payload hash + schemaVersion + 15m 過期。
/// confirm 重驗 hash/auth/state；失敗不消耗、成功消耗（consumedAt）。M2 紅卡 L83-94。
model QuestionValidationToken {
  /// UUID v7（app 層產生）
  id              String    @id @db.Uuid
  /// raw token 的 SHA-256 hash，唯一
  tokenHash       String    @unique @map("token_hash")
  accountId       String    @map("account_id") @db.Uuid
  /// optional CLI 綁定；Web validate 為 null
  cliCredentialId String?   @map("cli_credential_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  /// canonical payload 的 SHA-256 hash（sha256:<hex>）
  payloadHash     String    @map("payload_hash")
  schemaVersion   Int       @default(1) @map("schema_version")
  /// now + 15m
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  /// 成功 confirm 後設；未消耗前為 null
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cliCredential CliCredential? @relation(fields: [cliCredentialId], references: [id], onDelete: SetNull)

  @@index([accountId, courseId], map: "idx_validation_token_account_course")
  @@map("question_validation_token")
}

/// 批次 confirm 冪等紀錄 — (actorScope, operation, idempotencyKey) 唯一。
/// same key+same hash replay responseJson；same key+different hash → 409 CONFLICT。M2 紅卡 L83-94。
model QuestionBatchIdempotency {
  /// UUID v7（app 層產生）
  id             String   @id @db.Uuid
  /// "web:<accountId>" | "cli:<credentialId>"
  actorScope     String   @map("actor_scope")
  operation      String   @default("question-batch-confirm")
  idempotencyKey String   @map("idempotency_key")
  /// canonical payload 的 SHA-256 hash
  payloadHash    String   @map("payload_hash")
  /// committed response（QuestionDto[] + payloadHash）
  responseJson   Json     @map("response_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([actorScope, operation, idempotencyKey], map: "uq_batch_idempotency_actor_op_key")
  @@index([actorScope, idempotencyKey], map: "idx_batch_idempotency_actor_key")
  @@map("question_batch_idempotency")
}
