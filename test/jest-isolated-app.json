{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "isolated-app\\.live-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!uuid/)"],
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup/mutation-guard.ts"]
}
