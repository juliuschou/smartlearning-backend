# Copy to .env.test and replace all placeholder secrets.
PORT=3001
NODE_ENV=test
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000

# Docker integration-test PostgreSQL (compose.test-db.yml)
# This database is dedicated and disposable. Never point it at development data.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smartlearning_test
DB_USERNAME=smartlearning_test
DB_PASSWORD=replace-with-test-only-password
DATABASE_URL="postgresql://smartlearning_test:replace-with-test-only-password@127.0.0.1:5432/smartlearning_test?schema=public"

COOKIE_SECRET=replace-with-openssl-rand-base64-32
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MODE=memory
REALTIME_REDIS_MODE=off
RETENTION_OPERATIONS_ENABLED=false
RETENTION_PURGE_ENABLED=false
RETENTION_PURGE_SCHEDULER_ENABLED=false
RETENTION_MANIFEST_EXPORT_ENABLED=false
RETENTION_MANIFEST_EXPORT_SCHEDULER_ENABLED=false
DELETION_MANIFEST_PROVIDER=local
