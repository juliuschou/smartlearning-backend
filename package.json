{
  "name": "smartlearning-backend",
  "version": "0.0.1",
  "description": "SmartLearning backend service",
  "private": true,
  "packageManager": "npm",
  "scripts": {
    "build": "nest build",
    "openapi:export": "npm run build && node dist/src/export-openapi.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:dev:config": "docker compose --env-file .env.development -p smartlearning-dev-db -f compose.dev-db.yml config",
    "db:dev:up": "docker compose --env-file .env.development -p smartlearning-dev-db -f compose.dev-db.yml up -d",
    "db:dev:status": "docker compose --env-file .env.development -p smartlearning-dev-db -f compose.dev-db.yml ps",
    "db:dev:logs": "docker compose --env-file .env.development -p smartlearning-dev-db -f compose.dev-db.yml logs dev-db",
    "db:dev:down": "docker compose --env-file .env.development -p smartlearning-dev-db -f compose.dev-db.yml down",
    "prisma:dev:validate": "prisma validate --config prisma.dev.config.ts",
    "prisma:dev:generate": "prisma generate --config prisma.dev.config.ts",
    "prisma:dev:deploy": "prisma migrate deploy --config prisma.dev.config.ts",
    "prisma:dev:status": "prisma migrate status --config prisma.dev.config.ts",
    "prisma:dev:pull": "prisma db pull --config prisma.dev.config.ts",
    "db:test:config": "docker compose --env-file .env.test -p smartlearning-test-db -f compose.test-db.yml config",
    "db:test:up": "docker compose --env-file .env.test -p smartlearning-test-db -f compose.test-db.yml up -d",
    "db:test:status": "docker compose --env-file .env.test -p smartlearning-test-db -f compose.test-db.yml ps",
    "db:test:logs": "docker compose --env-file .env.test -p smartlearning-test-db -f compose.test-db.yml logs test-db",
    "db:test:down": "docker compose --env-file .env.test -p smartlearning-test-db -f compose.test-db.yml down",
    "bootstrap:admin": "npm run build && node dist/src/bootstrap/bootstrap-admin.js",
    "bootstrap:w1-teacher": "npm run build && node dist/src/bootstrap/provision-local-w1-teacher.js",
    "retention": "node dist/src/bootstrap/retention.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:login-rate-limit:redis": "jest --config ./test/jest-redis-integration.json --runInBand",
    "test:cp5:e2e": "jest --config ./test/jest-cp5-e2e.json --runInBand",
    "test:cp6:manual": "jest --config ./test/jest-cp6-e2e.json --runInBand",
    "test:cp7:manual": "jest --config ./test/jest-cp7-e2e.json --runInBand",
    "test:cp8:static": "jest --config ./test/jest-cp8-static.json --runInBand",
    "test:retention:artifacts": "jest --config ./test/jest-retention-artifacts.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "gate3:static": "bash tools/gate3/static-check.sh",
    "gate3:test": "bash tools/gate3/tests/run.sh",
    "gate3:preflight": "bash tools/gate3/gate3.sh preflight",
    "gate3:up": "bash tools/gate3/gate3.sh up",
    "gate3:status": "bash tools/gate3/gate3.sh status",
    "gate3:source": "bash tools/gate3/gate3.sh source",
    "gate3:doctor": "bash tools/gate3/gate3.sh doctor",
    "gate3:down": "bash tools/gate3/gate3.sh down",
    "gate3": "bash tools/gate3/gate3.sh",
    "env:doctor": "bash tools/dev/env-doctor.sh",
    "env:doctor:test": "bash tools/dev/env-doctor.test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.862.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.23.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "redis": "6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "js-yaml": "5.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!uuid/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
