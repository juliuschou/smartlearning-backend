# CP8 verification-only environment. Do not use for production.
# Run Compose with a unique project name and keep all internal services unexposed.
CP8_DB_USERNAME=smartlearning
CP8_DB_PASSWORD=replace-with-a-test-only-password
CP8_COOKIE_SECRET=replace-with-a-test-only-cookie-secret
CP8_HMAC_SECRET=replace-with-a-separate-test-only-hmac-secret
CP8_EXTERNAL_ORIGIN=https://localhost:8443
CP8_HTTPS_PORT=8443
