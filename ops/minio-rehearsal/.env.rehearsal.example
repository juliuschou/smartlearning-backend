# Template for the operator-supplied root credential used ONLY by setup.sh to
# create the bucket and the scoped write-only rehearsal user. Copy to .env and
# set before running ops/minio-rehearsal/setup.sh. If unset, throwaway defaults
# in docker-compose.yml are used (fine for a local disposable sandbox, but the
# values here are what the root user is created with).
#
# IMPORTANT: the docker-compose.yml reads these at container-creation time, so
# they must be set before `docker compose ... up -d`. The generated write-only
# app credential lives in .env.minio-rehearsal (gitignored).
MINIO_ROOT_USER=change-me-root
MINIO_ROOT_PASSWORD=change-me-root-password
