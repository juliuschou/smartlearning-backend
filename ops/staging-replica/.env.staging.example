# BE-5.2 Checkpoint G step 5 — staging canary replica environment (EXAMPLE).

# Copy to `.env.staging` (gitignored) and fill real generated values:
#   cp ops/staging-replica/.env.staging.example ops/staging-replica/.env.staging
#   # COOKIE_SECRET / MINIO_ROOT_PASSWORD: openssl rand -base64 32
#
# NEVER commit .env.staging. Never reuse production or rehearsal credentials.

# --- Staging replica identity ------------------------------------------------
# These are the values the preflight will assert against (env-source check).
NODE_ENV=production
PORT=3000
# Any explicit origin is fine; it must NOT be `*` (CSRF fail-closed).
CORS_ORIGIN=http://localhost:13000

DB_USERNAME=sl_staging
DB_PASSWORD=GENERATE_ME
DB_NAME=smartlearning_staging_replica

COOKIE_SECRET=GENERATE_ME

# Realtime is optional for the canary; keep the local/optional default.
REALTIME_REDIS_MODE=optional

# --- Manifest export: dedicated staging MinIO (NOT production) ---------------
DELETION_MANIFEST_PROVIDER=s3
S3_ENDPOINT=http://staging-replica-minio:9000
S3_REGION=us-east-1
# Provisioned by setup.sh (Object Lock + versioning + write-only user).
S3_BUCKET=sl-staging-manifests
S3_PREFIX=deletion-manifests
S3_ACCESS_KEY_ID=FILLED_BY_SETUP
S3_SECRET_ACCESS_KEY=FILLED_BY_SETUP
S3_OBJECT_LOCK_DAYS=90
S3_SERVER_SIDE_ENCRYPTION=none # MinIO without KMS rejects the AES256 header; the real staging/production store sets AES256

# --- Retention gates: ALL MUTATION GATES OFF --------------------------------
# Master gate on (app boots, metrics scrape); every operation and scheduler
# gate OFF. The canary runbook enables exactly one operation gate per one-shot
# CLI invocation; the long-running backend must never run with them on.
RETENTION_OPERATIONS_ENABLED=true
RETENTION_PURGE_ENABLED=false
RETENTION_PURGE_SCHEDULER_ENABLED=false
RETENTION_PURGE_TICK_MS=900000
RETENTION_PURGE_BATCH_SIZE=1
RETENTION_PURGE_LEASE_MS=10000
RETENTION_PURGE_MAX_ATTEMPTS=5
RETENTION_MANIFEST_EXPORT_ENABLED=false
RETENTION_MANIFEST_EXPORT_SCHEDULER_ENABLED=false
RETENTION_MANIFEST_EXPORT_TICK_MS=900000
RETENTION_MANIFEST_EXPORT_BATCH_SIZE=1
RETENTION_RECONCILE_APPLY_ENABLED=false
RETENTION_LOCAL_MANIFEST_FILE=/tmp/staging-replica-manifests.json