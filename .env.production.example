# SmartLearning backend — production env template.
#
# Copy to `.env.production` and fill in real values before `docker compose up`.
# `.env.production` is gitignored — never commit real secrets.
#
#   cp .env.production.example .env.production
#   openssl rand -base64 32   # → COOKIE_SECRET

# Application
PORT=3000
NODE_ENV=production
# CORS: comma-separated exact origins (NO "*" in production).
CORS_ORIGIN=http://localhost:3000

# Database — values are interpolated into docker-compose's DATABASE_URL.
DB_USERNAME=smartlearning
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=smartlearning
DB_PORT=5433

# Secrets — cookie signing / __Host- session cookies.
COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Web Session lifetime (defaults shown; M2 §4).
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
# __Host- cookies require Secure. Leave true in production.
SESSION_COOKIE_SECURE=true

# CLI operation rate limits (per CliCredential.id). These counters are local to
# one process until the CP5 Redis-backed implementation is deployed.
CLI_COURSES_LIST_RATE_LIMIT_MAX=60
CLI_COURSES_LIST_RATE_LIMIT_WINDOW_MS=60000
CLI_COURSES_CREATE_RATE_LIMIT_MAX=10
CLI_COURSES_CREATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_VALIDATE_RATE_LIMIT_MAX=30
CLI_BATCH_VALIDATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_CONFIRM_RATE_LIMIT_MAX=20
CLI_BATCH_CONFIRM_RATE_LIMIT_WINDOW_MS=60000

# Realtime Redis adapter. Keep `off` for a single instance; use `required`
# only when Redis is provisioned and readiness must fail closed.
REALTIME_REDIS_MODE=off
# REDIS_URL=redis://redis:6379