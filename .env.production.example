# SmartLearning backend — production env template.
# Copy to `.env.production` and fill in real values before `docker compose up`.
# `.env.production` is gitignored — never commit real secrets.
#
#   cp .env.production.example .env.production
#   openssl rand -base64 32   # → COOKIE_SECRET and LOGIN_RATE_LIMIT_KEY_SECRET

PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
# Set TRUST_PROXY_HOPS=1 only when traffic always arrives through one trusted proxy.
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000

# Database — values are interpolated into docker-compose's DATABASE_URL.
DB_USERNAME=smartlearning
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=smartlearning
DB_PORT=5433

COOKIE_SECRET=replace-with-openssl-rand-base64-32
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
SESSION_COOKIE_SECURE=true

# Login rate limit is shared and fail-closed in production.
LOGIN_RATE_LIMIT_MODE=redis-required
LOGIN_RATE_LIMIT_REDIS_URL=redis://redis:6379
LOGIN_RATE_LIMIT_KEY_SECRET=replace-with-a-separate-32-character-secret
LOGIN_RATE_LIMIT_ACCOUNT_MAX=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_SOURCE_MAX=20
LOGIN_RATE_LIMIT_SOURCE_WINDOW_MS=300000
LOGIN_RATE_LIMIT_CONNECT_TIMEOUT_MS=2000
LOGIN_RATE_LIMIT_COMMAND_TIMEOUT_MS=500

# CLI operation rate limits remain process-local in CP4.
CLI_COURSES_LIST_RATE_LIMIT_MAX=60
CLI_COURSES_LIST_RATE_LIMIT_WINDOW_MS=60000
CLI_COURSES_CREATE_RATE_LIMIT_MAX=10
CLI_COURSES_CREATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_VALIDATE_RATE_LIMIT_MAX=30
CLI_BATCH_VALIDATE_RATE_LIMIT_WINDOW_MS=60000
CLI_BATCH_CONFIRM_RATE_LIMIT_MAX=20
CLI_BATCH_CONFIRM_RATE_LIMIT_WINDOW_MS=60000

# Realtime Redis adapter is independent from the login limiter.
# The base Compose stack keeps the adapter disabled; CP8 enables it in its
# verification-only topology with a dedicated REDIS_URL.
REALTIME_REDIS_MODE=off
# REDIS_URL=redis://redis:6379/0

# Deletion manifest provider. Production rejects the process-local provider
# (DELETION_MANIFEST_PROVIDER=local) and S3_SERVER_SIDE_ENCRYPTION=none; a
# durable, verification-capable S3 provider is required before purge can run.
DELETION_MANIFEST_PROVIDER=local
# S3_ENDPOINT=https://s3.example.invalid   # must be https: in production
# S3_REGION=us-east-1
# S3_BUCKET=smartlearning-manifests
# S3_PREFIX=deletion-manifests
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_OBJECT_LOCK_DAYS=90
# SSE mode: AES256 (default), aws:kms, or none (stores without SSE support).
# none is rejected in production.
# S3_SERVER_SIDE_ENCRYPTION=AES256
# Required when S3_SERVER_SIDE_ENCRYPTION=aws:kms
# S3_KMS_KEY_ID=
