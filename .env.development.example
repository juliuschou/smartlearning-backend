# Copy to .env.development and replace all placeholder secrets.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000

# Docker development PostgreSQL (compose.dev-db.yml)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=smartlearning_dev
DB_USERNAME=smartlearning_dev
DB_PASSWORD=replace-with-development-only-password
DATABASE_URL="postgresql://smartlearning_dev:replace-with-development-only-password@127.0.0.1:5433/smartlearning_dev?schema=public"

COOKIE_SECRET=replace-with-openssl-rand-base64-32
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
LOGIN_RATE_LIMIT_MODE=memory
REALTIME_REDIS_MODE=off
RETENTION_OPERATIONS_ENABLED=false
RETENTION_PURGE_ENABLED=false
RETENTION_PURGE_SCHEDULER_ENABLED=false
RETENTION_MANIFEST_EXPORT_ENABLED=false
RETENTION_MANIFEST_EXPORT_SCHEDULER_ENABLED=false
DELETION_MANIFEST_PROVIDER=local
